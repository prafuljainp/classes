# Sales Insight Agent - Environment Configuration Example
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to version control - it contains secrets!

# ==================== DATABASE CONFIGURATION ====================
DB_URL=jdbc:mysql://localhost:3306/sales
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# ==================== EMAIL CONFIGURATION ====================
# Gmail SMTP Settings
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=your-email@gmail.com
# Use App Password, NOT your regular Gmail password
# Generate at: https://myaccount.google.com/apppasswords
MAIL_SMTP_PASSWORD=your_16_char_app_password
MAIL_RECIPIENT=recipient@example.com
MAIL_SUBJECT=Weekly Sales Insight Report
MAIL_BODY=Hello,\n\nPlease find the weekly sales insight report below.\n\nBest regards,\nSales Team

# ==================== GEMINI API CONFIGURATION ====================
# Get your API key from: https://ai.google.dev
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_MODEL=gemini-1.5-flash
GEMINI_API_TEMPERATURE=0.5
GEMINI_API_MAX_OUTPUT_TOKENS=1000

# ==================== OPTIONAL: LOGGING ====================
# Set to 'dev' for more verbose logging (default: production)
# LOGBACK_PROFILE=dev
